{
  "name": "trustweave-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron wrapper that runs the TrustWeave backend and dashboard locally",
  "author": "TrustWeave",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.trustweave.desktop",
    "productName": "TrustWeave",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!reports/**",
          "!test/**",
          "!*.test.js",
          "!.env",
          "!.env.*",
          "!package-lock.json"
        ]
      },
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.next/cache/**",
          "!test-results/**",
          "!playwright-report/**",
          "!.screenshots/**",
          "!tests/**",
          "!.env",
          "!.env.*",
          "!package-lock.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"],
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
